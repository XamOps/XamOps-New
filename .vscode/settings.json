    "java.compile.nullAnalysis.mode": "automatic",
    "java.jdt.ls.vmargs": "-Xmx4G -Xms100m",
    "java.debug.settings.onBuildFailureProceed": true,
    "java.jdt.ls.java.home": "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home",
