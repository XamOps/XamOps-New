          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "// No session -> the controller answers 401 itself; a security filter may also",
                  "// return 401/403 before the handler runs.",
                  "pm.test('Unauthenticated is rejected (401/403)', function () {",
