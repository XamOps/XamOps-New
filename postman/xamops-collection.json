                  "// error state rather than a measured 'all clear'). 401/403 when protected.",
                  "pm.test('No server error except 503 for upstream failure', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 503]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Response body is an array', function () {",
                  "        pm.expect(pm.response.json()).to.be.an('array');",
                  "    });",
