{
  "info": {
    "name": "XamOps API",
    "description": "Starter collection for the XamOps platform (xamops-service :8080, billops :8082, mediaops :8084). Uses environment variables for all URLs and credentials. Assertions are CI-safe: they fail on server errors (5xx) but tolerate expected auth rejections when credentials are not supplied.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "XamOps Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{XAMOPS_URL}}/actuator/health",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service reports UP', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});",
                  "pm.test('Responds within 10s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Initiate Login (send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{AUTH_EMAIL}}\",\n  \"password\": \"{{AUTH_PASSWORD}}\"\n}"
            },
            "url": {
              "raw": "{{XAMOPS_URL}}/api/auth/initiate-login",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["api", "auth", "initiate-login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "const hasCreds = pm.environment.get('AUTH_EMAIL') && pm.environment.get('AUTH_PASSWORD');",
                  "if (hasCreds) {",
                  "    pm.test('Login accepted with credentials', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "    });",
                  "} else {",
                  "    pm.test('Rejects missing credentials (400/401)', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{AUTH_EMAIL}}\",\n  \"otp\": \"{{AUTH_OTP}}\"\n}"
            },
            "url": {
              "raw": "{{XAMOPS_URL}}/api/auth/verify-login-otp",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["api", "auth", "verify-login-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "const hasOtp = pm.environment.get('AUTH_EMAIL') && pm.environment.get('AUTH_OTP');",
                  "if (hasOtp) {",
                  "    pm.test('OTP verification returns 200', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "} else {",
                  "    pm.test('Rejects missing OTP (400/401)', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Google Auth",
      "item": [
        {
          "name": "Google Login (redirect to Google or error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{XAMOPS_URL}}/api/auth/google/login",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["api", "auth", "google", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The login entry point must never 500 (it catches Redis/config failures and",
                  "// falls back to the login page). It always answers with a redirect: either to",
                  "// Google's consent screen when configured, or back to /login?error=... when not.",
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "pm.test('Returns a redirect (3xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302, 303, 307, 308]);",
                  "});",
                  "const location = pm.response.headers && pm.response.headers.location;",
                  "if (location) {",
                  "    pm.test('Redirects to Google or back to the login page', function () {",
                  "        const ok = /accounts\\.google\\.com/.test(location) || /\\/login\\?error=/.test(location);",
                  "        pm.expect(ok).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Callback (no code/state -> login error redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{XAMOPS_URL}}/api/auth/google/callback",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["api", "auth", "google", "callback"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// With no code/state the callback cannot resolve a stored redirect-uri, so it",
                  "// redirects back to the login page with error=google_state. It must never 5xx.",
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "pm.test('Returns a redirect (3xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302, 303, 307, 308]);",
                  "});",
                  "const location = pm.response.headers && pm.response.headers.location;",
                  "if (location) {",
                  "    pm.test('Redirects to the login page with an error', function () {",
                  "        pm.expect(/\\/login\\?error=/.test(location)).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Signup (missing token -> 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Inc\"\n}"
            },
            "url": {
              "raw": "{{XAMOPS_URL}}/api/auth/google/complete-signup",
              "host": ["{{XAMOPS_URL}}"],
              "path": ["api", "auth", "google", "complete-signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "// A request without a signup token is rejected up front with 400 (the endpoint",
                  "// is public). 401/403 is tolerated if a security filter intercepts first.",
                  "pm.test('Missing signup token is rejected (400/401/403)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Trial Status (unauthenticated -> 401)",
          "request": {
            "method": "GET",
