          "name": "Security Data (wrapper - standalone page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{XAMOPS_URL}}/api/xamops/azure/security?accountId={{AZURE_SUBSCRIPTION_ID}}&forceRefresh=false",
