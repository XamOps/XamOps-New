                  "// first (401/403) when the endpoint is protected.",
                  "pm.test('No server error (not 5xx)', function () {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "pm.test('Known outcome (200/401/403)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Response body is a wrapper object with a status', function () {",
                  "        const body = pm.response.json();",
                  "        pm.expect(body).to.be.an('object');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Security Findings (array - dashboard card)",
          "request": {
            "method": "GET",
            "header": [],
