# Frontend build output
/frontend-app/dist/

# Local nginx config
nginx-react.conf
frontend-app/tsc_output*.txt


# Ignore build artifacts
# Unanchored: the anchored rules below covered two modules, so permissions-common/target/
# was never ignored and 27 of its .class files ended up tracked.
target/
/xamops-service/target/
/media-ops-service/target/
*.jar

# Go binaries
xamops-agent/agent
xamops-autoscaler/autoscaler
**/agent
**/autoscaler

# Ignore node_modules
/frontend-app/node_modules/
node_modules/
frontend-app/node_modules/
.idea/

# Snyk Security Extension - AI Rules (auto-generated)
.github\instructions\snyk_rules.instructions.md
.cursor/rules/snyk_rules.mdc

# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md


# Kubernetes configs (DO NOT COMMIT)
# NOTE: this was `kubeconfig*`, which with core.ignorecase=true (macOS) also matched
# SOURCE files whose name merely begins with "Kubeconfig" --
# KubeconfigClusterAccessProvider.java was silently excluded from a commit while
# `git status` reported the tree clean and committed tests referenced the class. The
# patterns below still cover every real credential file name (kubeconfig,
# kubeconfig-prod, kubeconfig.yaml, cluster.kubeconfig) but cannot swallow a .java file.
kubeconfig
kubeconfig-*
kubeconfig_*
kubeconfig.*
*.kubeconfig
.kube/
logs/
*.log
*.gz

# AI/Session files
.claude/
# NOTE: this repo has core.ignorecase=true (macOS), which makes gitignore patterns
# case-insensitive -- so [A-Z_] also matches lowercase and this rule ignores EVERY .md
# file starting with a letter, not just the uppercase agent files it was written for.
# Deliberate documentation is therefore un-ignored below rather than by narrowing the
# pattern, which cannot work while matching is case-insensitive.
[A-Z_]*.md
!CONTRIBUTING.md
!docs/**/*.md

# Backups and temporary files
*.html.bak
*.html.tmp
*.disabled
*.bak
*.backup
*.rd

# Vite dev cache
frontend-app/vite.config.*.mjs
frontend-app/vite.config.ts.timestamp-*

# Temp/scratch files
tmpclaude-*
=
resolve
threads.txt
cookies.txt
last_logs.txt
risp_response.json
find_dups.*
TestClass.java
test-actions-history.html
verify-tenant-isolation.bat

