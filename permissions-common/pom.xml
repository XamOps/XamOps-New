<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xammer</groupId>
        <artifactId>xamops-platform</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>permissions-common</artifactId>
    <version>1.0.0</version>
    <name>permissions-common</name>
    <description>
        Shared detection and storage for cloud permission gaps — the record of which
        API calls a customer's IAM role is currently refusing. Lives here rather than
        in one service because XamOps, BillOps and MediaOps all read the same customer
        accounts, and a permission removed in AWS blanks out data in all three.
    </description>

    <dependencies>
        <!-- Beans, @Service, @Value. Not the web starter — this module never serves HTTP. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- RestClient, for the outbound SMS/WhatsApp provider in com.xammer.cloud.messaging.
             spring-web is the client library only; it does not make this module serve HTTP
             and pulls in no servlet container. The alert and report senders live in
             xamops-service while the support auto-ping lives in billops, so the provider
             client sits here rather than being implemented twice. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- @ConfigurationProperties binding for MessagingProperties. Available transitively
             via the Redis starter, but declared explicitly because this module depends on it
             directly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!-- Shared store, so a gap seen by a background refresh on one service is
             visible to an API request served by another. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- SDK interceptor hook + the service exceptions we classify. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A library, not an application: keep the plain jar, do not repackage. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
