# DEV-ONLY placeholder passwords for the local XamPulse stack. Copy to .env (git-ignored) and change if you like.
# Never reuse these anywhere that is reachable from a network.
XP_CH_WRITER_PASSWORD=dev-only-writer-change-me
XP_CH_READER_PASSWORD=dev-only-reader-change-me

# Only for the optional local edge (docker compose --profile edge). Must equal xampulse.internal-secret
# (application-local.properties). Dev-only value.
XP_INTERNAL_SECRET=
