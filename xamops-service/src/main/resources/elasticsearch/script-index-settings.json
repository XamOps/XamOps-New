{
  "index": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "max_result_window": 10000,
    "analysis": {
      "analyzer": {
        "script_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "script_stop",
            "script_synonym",
            "porter_stem"
          ]
        },
        "code_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      },
      "filter": {
        "script_stop": {
          "type": "stop",
          "stopwords": [
            "the",
            "a",
            "an",
            "and",
            "or",
            "but",
            "is",
            "are",
            "was",
            "were",
            "be",
            "been",
            "being",
            "have",
            "has",
            "had",
            "do",
            "does",
            "did",
            "will",
            "would",
            "should",
            "could",
            "may",
            "might",
            "must",
            "can"
          ]
        },
        "script_synonym": {
          "type": "synonym",
          "synonyms": [
            "ec2, instance, vm, virtual machine",
            "s3, bucket, storage",
            "rds, database, db",
            "vpc, network, vnet",
            "lambda, function, serverless",
            "eks, kubernetes, k8s, gke, aks",
            "terraform, tf, iac",
            "ansible, playbook, configuration management",
            "bash, shell, script",
            "python, py",
            "aws, amazon web services",
            "azure, microsoft azure",
            "gcp, google cloud platform",
            "iam, identity, access management, rbac",
            "security group, firewall, network acl",
            "load balancer, elb, alb, nlb",
            "autoscaling, auto scaling, scaling group",
            "cloudfront, cdn, content delivery",
            "route53, dns, domain",
            "backup, snapshot, restore",
            "monitoring, cloudwatch, metrics, logs",
            "deployment, deploy, ci/cd, pipeline"
          ]
        }
      }
    }
  }
}
