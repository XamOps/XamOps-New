{
  "annotations": {
    "list": []
  },
  "editable": true,
  "schemaVersion": 39,
  "title": "XamOps DB Health (CNPG)",
  "tags": [
    "break-it",
    "xamops",
    "db",
    "cnpg"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "CNPG \u2014 primary instance (role)",
      "description": "cnpg_collector_up / cnpg pg_replication role. The primary is the writable instance; a change is a failover.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "cnpg_pg_replication_in_recovery == 0",
          "legendFormat": "primary: {{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CNPG \u2014 collector up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(cnpg_collector_up)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CNPG \u2014 replication lag (seconds)",
      "description": "cnpg_pg_replication_lag per replica. Spikes during drains/failover.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "cnpg_pg_replication_lag",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CNPG \u2014 in-recovery flag (0 = primary, 1 = replica)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "cnpg_pg_replication_in_recovery",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CNPG \u2014 active backends / connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "cnpg_backends_total",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB fixtures \u2014 pod readiness (kube-state-metrics)",
      "description": "Fallback DB-pod health for mysql/mongo/pg-unsafe fixtures that have no built-in exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "kube_pod_status_ready{namespace=\"xamops-db-fixtures\",condition=\"true\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ],
  "uid": "xamops-break-db-health"
}

